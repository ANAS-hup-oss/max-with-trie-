
const int B = 20;
const int N = 1 << B;
const long long U = (1LL << B) - 1; // Mask لكل الـ Bits المتاحة (111...1)

// Struct موحد يعتمد على Subsets و MaxAND فقط
struct SubsetsTrie {
    struct Node {
        int next[2];
        int cnt;

        Node() {
            next[0] = next[1] = -1;
            cnt = 0;
        }
    };

    vector<Node> trie;
    vector<int> ref_cnt;
    int mxBit;

    int addNode() {
        trie.emplace_back();
        return trie.size() - 1;
    }

    SubsetsTrie(int mx = B - 1) : mxBit(mx), ref_cnt(N, 0) {
        addNode();
    }

    void insertNode(long long x) {
        int cur = 0;
        trie[cur].cnt++;
        for (int i = mxBit; i >= 0; --i) {
            int t = (x >> i) & 1LL;
            if (trie[cur].next[t] == -1)
                trie[cur].next[t] = addNode();
            cur = trie[cur].next[t];
            trie[cur].cnt++;
        }
    }

    void removeNode(long long x) {
        int cur = 0;
        trie[cur].cnt--;
        for (int i = mxBit; i >= 0; --i) {
            int t = (x >> i) & 1LL;
            cur = trie[cur].next[t];
            trie[cur].cnt--;
        }
    }

    void insertDFS(long long x) {
        ref_cnt[x]++;
        if (ref_cnt[x] == 1) {
            insertNode(x);
            for (int i = 0; i < B; ++i) {
                if ((x >> i) & 1LL) {
                    insertDFS(x ^ (1LL << i));
                }
            }
        }
    }

    void removeDFS(long long x) {
        if (ref_cnt[x] == 0) return;
        ref_cnt[x]--;
        if (ref_cnt[x] == 0) {
            removeNode(x);
            for (int i = 0; i < B; ++i) {
                if ((x >> i) & 1LL) {
                    removeDFS(x ^ (1LL << i));
                }
            }
        }
    }

    // MaxAND Query
    long long get(long long x) {
        if (trie[0].cnt == 0) return -1;
        int cur = 0;
        long long ans = 0;
        for (int i = mxBit; i >= 0; --i) {
            int t = (x >> i) & 1LL;
            if (t) {
                int ch = trie[cur].next[1];
                if (ch != -1 && trie[ch].cnt > 0) {
                    ans |= (1LL << i);
                    cur = ch;
                } else {
                    cur = trie[cur].next[0];
                }
            } else {
                cur = trie[cur].next[0]; // إجباري الذهاب لـ 0 لحفظ الـ Subsets
            }
        }
        return ans;
    }
};

struct BitOperations {
    SubsetsTrie trieNormal;
    SubsetsTrie trieInverted;

    void insert(long long x) {
        trieNormal.insertDFS(x);
        trieInverted.insertDFS(U ^ x);
    }

    void remove(long long x) {
        trieNormal.removeDFS(x);
        trieInverted.removeDFS(U ^ x);
    }

    long long mxAND(long long x) {
        return trieNormal.get(x);
    }

    long long mxOR(long long x) {
        return x | trieNormal.get(U ^ x);
    }

    long long mnAND(long long x) {
        long long val = trieInverted.get(x);
        if (val == -1) return -1;
        return x ^ val;
    }

    long long mnOR(long long x) {
        long long notX = U ^ x;
        long long val = trieInverted.get(notX);
        if (val == -1) return -1;
        return x | (notX ^ val);
    }
};
