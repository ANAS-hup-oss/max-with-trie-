struct BinaryTrie {
    struct Node {
        int frq[2];
        Node *ch[2];

        Node() {
            frq[0] = frq[1] = 0;
            memset(ch, 0, sizeof ch);
        }
    };

    Node *root = new Node();

    void insert(int x) {
        Node *cur = root;
        for (int i = 29; i >= 0; i--) {
            bool idx = (x >> i) & (1);
            if (cur->ch[idx] == 0) {
                cur->ch[idx] = new Node();
            }
            cur->frq[idx]++;
            cur = cur->ch[idx];
        }
    }

    BinaryTrie() {
        insert(0);
    }

    void del(int x,int i, Node *cur) {
        if (i == -1)return;
        bool idx = (x >> i) & (1);
        del(x, i - 1, cur->ch[idx]);
        cur->frq[idx]--;
        if (cur->frq[idx] == 0) {
            delete cur->ch[idx];
            cur->ch[idx] = nullptr;
        }
    }

    int mxXor(int x) {
        int ret = 0;
        Node *cur = root;
        for (int i = 29; i >= 0; i--) {
            bool idx = (x >> i) & (1);
            bool tar = (idx ^ 1);
            if (cur->ch[tar] == 0) {
                cur = cur->ch[idx];
            } else {
                ret |= (1 << i);
                cur = cur->ch[tar];
            }
        }
        return ret;
    }
};
