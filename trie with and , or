

const int B = 20;
const long long N = 1LL << B;

bool vis[N];

struct Trie {
    vector<vector<int>> trie;
    int mxBit, sz;

    int addNode() {
        trie.push_back({-1, -1});
        return sz++;
    }

    Trie(int mx = B - 1) : mxBit(mx), sz(0) {
        addNode();
    }

    void insert(long long x) {
        int cur = 0;
        for (int i = mxBit; i >= 0; i--) {
            int b = (x >> i) & 1LL;
            if (trie[cur][b] == -1)
                trie[cur][b] = addNode();
            cur = trie[cur][b];
        }
    }

    long long mxOR(long long x) {
        int cur = 0;
        long long ans = 0;

        for (int i = mxBit; i >= 0; i--) {
            int b = (x >> i) & 1LL;

            if (b) {
                ans |= (1LL << i);
                if (trie[cur][1] != -1) cur = trie[cur][1];
                else cur = trie[cur][0];
            } else {
                if (trie[cur][1] != -1) {
                    ans |= (1LL << i); // نفضل الـ 1 لزيادة القيمة
                    cur = trie[cur][1];
                } else {
                    cur = trie[cur][0];
                }
            }
        }
        return ans;
    }

   
    long long mnOR(long long x) {
        int cur = 0;
        long long ans = 0;

        for (int i = mxBit; i >= 0; i--) {
            int b = (x >> i) & 1LL;

            if (b) {
                ans |= (1LL << i); 
                if (trie[cur][0] != -1) cur = trie[cur][0];
                else cur = trie[cur][1];
            } else {
                if (trie[cur][0] != -1) {
                    cur = trie[cur][0]; // نفضل الـ 0 لتصغير القيمة
                } else {
                    ans |= (1LL << i);
                    cur = trie[cur][1];
                }
            }
        }
        return ans;
    }

    long long mxAND(long long x) {
        int cur = 0;
        long long ans = 0;

        for (int i = mxBit; i >= 0; i--) {
            int b = (x >> i) & 1LL;

            if (b) {
                if (trie[cur][1] != -1) {
                    ans |= (1LL << i); // الـ AND بيدي 1 فقط لو اخترنا 1
                    cur = trie[cur][1];
                } else {
                    cur = trie[cur][0];
                }
            } else {
                if (trie[cur][1] != -1) cur = trie[cur][1];
                else cur = trie[cur][0];
            }
        }
        return ans;
    }

    long long mnAND(long long x) {
        int cur = 0;
        long long ans = 0;

        for (int i = mxBit; i >= 0; i--) {
            int b = (x >> i) & 1LL;

            if (b) {
                if (trie[cur][0] != -1) {
                    cur = trie[cur][0]; // نفضل الـ 0 علشان نخلي الناتج 0
                } else {
                    ans |= (1LL << i);
                    cur = trie[cur][1];
                }
            } else {
            
                if (trie[cur][0] != -1) cur = trie[cur][0];
                else cur = trie[cur][1];
            }
        }
        return ans;
    }
};

void dfsSuper(long long x, Trie &trie) {
    if (x >= N || vis[x]) return;
    vis[x] = true;

    trie.insert(x);

    for (int i = 0; i < B; i++) {
        if (((x >> i) & 1LL) == 0) {
            dfsSuper(x | (1LL << i), trie);
        }
    }
}
