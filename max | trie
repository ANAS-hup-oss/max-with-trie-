const int B = 20;
const int N = 1 << B;

bool vis[N];

struct Trie {
    vector<vector<int>> trie;
    int mxBit, sz;

    int addNode() {
        trie.push_back({-1, -1});
        return sz++;
    }

    Trie(int mx = 19) : mxBit(mx), sz(0) {
        addNode();
    }

    void insert(int x) {
        int cur = 0;
        for (int i = mxBit; i >= 0; i--) {
            int b = (x >> i) & 1;
            if (trie[cur][b] == -1)
                trie[cur][b] = addNode();
            cur = trie[cur][b];
        }
    }

    int getOR(int x) {
        int cur = 0;
        int ans = 0;

        for (int i = mxBit; i >= 0; i--) {
            int b = (x >> i) & 1;

            if (b) {
                ans |= (1 << i);

                if (trie[cur][1] != -1)
                    cur = trie[cur][1];
                else
                    cur = trie[cur][0];
            } else {
                if (trie[cur][1] != -1) {
                    ans |= (1 << i);
                    cur = trie[cur][1];
                } else
                    cur = trie[cur][0];
            }
        }

        return ans;
    }
};

void dfsSuper(int x, Trie &trie) {
    if (vis[x]) return;
    vis[x] = true;

    trie.insert(x);

    for (int i = 0; i < B; i++) {
        if (((x >> i) & 1) == 0) {
            dfsSuper(x | (1 << i), trie);
        }
    }
}
