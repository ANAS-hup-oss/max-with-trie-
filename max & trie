const int B = 20;
const int N = 1 << B;

struct MaxAND {
    struct Node {
        int next[2];
        int cnt; // عداد لمعرفة كم رقم معدي على النود دي
        Node() {
            next[0] = next[1] = -1;
            cnt = 0;
        }
    };

    vector<Node> trie;
    vector<int> ref_cnt; // عداد للأرقام اللي زارها الـ DFS
    int mxBit;

    int addNode() {
        trie.emplace_back();
        return trie.size() - 1;
    }

    MaxAND(int mx = B - 1) : mxBit(mx), ref_cnt(N, 0) {
        addNode(); // Root Node
    }

    // إدراج عادي في الـ Trie
    void insertNode(long long x) {
        int cur = 0;
        trie[cur].cnt++;
        for (int i = mxBit; i >= 0; --i) {
            int t = (x >> i) & 1LL;
            if (trie[cur].next[t] == -1)
                trie[cur].next[t] = addNode();
            cur = trie[cur].next[t];
            trie[cur].cnt++; // زيادة العداد
        }
    }

    // حذف عادي من الـ Trie
    void removeNode(long long x) {
        int cur = 0;
        trie[cur].cnt--;
        for (int i = mxBit; i >= 0; --i) {
            int t = (x >> i) & 1LL;
            cur = trie[cur].next[t];
            trie[cur].cnt--; // تنقيص العداد
        }
    }

    // DFS للإدراج (Subsets)
    void insertDFS(long long x) {
        ref_cnt[x]++;
        if (ref_cnt[x] == 1) {
            // أول مرة نولد الـ subset ده
            insertNode(x);
            for (int i = 0; i < B; ++i) {
                if ((x >> i) & 1LL) {
                    insertDFS(x ^ (1LL << i));
                }
            }
        }
    }

    // DFS للحذف (Subsets)
    void removeDFS(long long x) {
        if (ref_cnt[x] == 0) return; // الرقم مش موجود اصلاً
        ref_cnt[x]--;
        if (ref_cnt[x] == 0) {
            // اتلغى تماماً
            removeNode(x);
            for (int i = 0; i < B; ++i) {
                if ((x >> i) & 1LL) {
                    removeDFS(x ^ (1LL << i));
                }
            }
        }
    }

    // الاستعلام مع التأكد إن cnt > 0
    long long get(long long x) {
        if (trie[0].cnt == 0) return -1; // الـ Trie فاضية تماماً

        int cur = 0, ans = 0;
        for (int i = mxBit; i >= 0; --i) {
            int t = (x >> i) & 1LL;
            if (t) {
                int ch = trie[cur].next[1];
                if (ch != -1 && trie[ch].cnt > 0) {
                    ans |= (1LL << i);
                    cur = ch;
                } else {
                    cur = trie[cur].next[0];
                }
            } else {
                int ch = trie[cur].next[0];
                if (ch != -1 && trie[ch].cnt > 0) {
                    cur = ch;
                } else {
                    cur = trie[cur].next[1];
                }
            }
        }
        return ans;
    }
};
