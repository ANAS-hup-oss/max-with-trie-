const int B = 20;
const int N = 1 << B;
bool vis[N];
 
 
struct Trie {
    vector<vector<int> > trie;
    int mxBit, sz;
 
    int addNode() {
        trie.emplace_back(2, -1);
        sz++;
        return sz - 1;
    }
 
    Trie(int mx = 19) : mxBit(mx), sz(0) {
        addNode();
    };
 
    void insert(int x, int type = 1) {
        int cur = 0;
        for (int i = mxBit; i >= 0; --i) {
            int t = (x >> i) & 1;
            if (trie[cur][t] == -1)
                trie[cur][t] = addNode();
            cur = trie[cur][t];
        }
    }
 
    int get(int x) {
        int cur = 0;
        int ans = 0;
        for (int i = mxBit; i >= 0; --i) {
            int t = (x >> i) & 1;
            if (trie[cur][t] == -1) {
                t ^= 1;
            }
            ans |= (t << i);
            cur = trie[cur][t];
        }
        return ans;
    }
};
 
void dfs(int x, Trie &trie) {
    if (vis[x]) return;
    vis[x] = true;
    trie.insert(x);
    for (int i = 0; i < B; ++i) {
        if (x >> i & 1) {
            dfs(x ^ (1 << i), trie);
        }
    }
}
